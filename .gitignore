build/
dist/

# Snakemake
.snakemake/

# Data: never committed; data/README.md lists the fetch commands
data/*
!data/README.md
# osmnx Overpass response cache
cache/

# Results: only summary tables are committed
results/**
!results/**/
!results/**/table_*.csv
!results/**/summary*.csv
!results/**/summary*.json

