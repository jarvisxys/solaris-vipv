# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
.pytest_cache/
.ruff_cache/
build/
dist/

# Snakemake
.snakemake/

# Data: never committed; data/README.md lists the fetch commands
data/*
!data/README.md
# osmnx Overpass response cache
cache/

# Results: only summary tables are committed
results/**
!results/**/
!results/**/table_*.csv
!results/**/summary*.csv
!results/**/summary*.json

# Unity project (twin/unity/SOLARIS-Twin)
twin/unity/**/[Ll]ibrary/
twin/unity/**/[Tt]emp/
twin/unity/**/[Ll]ogs/
twin/unity/**/[Oo]bj/
twin/unity/**/[Bb]uild/
twin/unity/**/[Bb]uilds/
twin/unity/**/[Uu]ser[Ss]ettings/
twin/unity/**/[Mm]emoryCaptures/
twin/unity/**/*.csproj
twin/unity/**/*.sln
twin/unity/**/*.slnx
twin/unity/**/*.user
twin/unity/**/.vscode/
twin/unity/SOLARIS-Twin/Assets/Geometry/
twin/unity/SOLARIS-Twin/Assets/Geometry.meta
twin/unity/SOLARIS-Twin/Recordings/

# Exchange files rebuilt by rule e8_export
twin/exchange/trajectories/
twin/exchange/render/
# Visual-only data for the Playback scene (twin/visual/export_visual.py)
twin/exchange/visual/

# LaTeX build products
paper/**/*.aux
paper/**/*.bbl
paper/**/*.blg
paper/**/*.fdb_latexmk
paper/**/*.fls
paper/**/*.log
paper/**/*.out
paper/**/*.synctex.gz

# OS and editors
.DS_Store
Thumbs.db
desktop.ini
.vscode/
.idea/

# UMEP/SuPy writes a log into the working directory when SOLWEIG runs
SuPy.log
